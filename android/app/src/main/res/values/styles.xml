<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied as soon as the process has started, and the colour
         behind the Flutter UI while it runs. Held at the launch yellow rather
         than the system background so that nothing white can appear between
         the native splash and the app's own opening animation. -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/nest_launch</item>
    </style>
</resources>
