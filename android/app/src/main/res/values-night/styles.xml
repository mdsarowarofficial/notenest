<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode gets the same launch colour on purpose. The app itself is
         light-only, so a dark window behind it would show as a dark rim for
         one frame on rotation and resize. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/nest_launch</item>
    </style>
</resources>
