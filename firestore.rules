rules_version = '2';

// NoteNest — Firestore security rules
//
// Paste this whole file into the Firebase console:
//   Build → Firestore Database → Rules → replace everything → Publish
//
// The shape of these rules is: deny everything, then open the narrowest door
// each feature actually needs. The last rule in the file is a catch-all deny,
// so a collection added later is closed until it is deliberately opened.
//
// There is no server code in this project — the Spark plan has no Cloud
// Functions — so this file is not a second line of defence behind a trusted
// backend. It *is* the defence. Every write in the app is made by a client
// that a determined person could replace, and the only thing standing between
// a replaced client and everyone else's notes is what is written here.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // Which fields a write actually changes. Used to pin an update down to
    // the one or two fields a feature is allowed to touch, so a rule that
    // permits "join a group" cannot also be used to rename it.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A string that is present, of the right type, and not longer than it has
    // any business being. Length limits are not fussiness: without them one
    // client can write a megabyte into a field everyone else downloads.
    function textWithin(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // ------------------------------------------------------------- users
    //
    // One document per account, at users/{uid}. It holds the name classmates
    // see, the folded email they are found by, and whether the account is a
    // student or a teacher.

    match /users/{userId} {

      // Reading one known profile. Needed to show who sent a note, who is in
      // a group, and who set an assignment.
      allow get: if signedIn();

      // Closed. This used to read `signedIn() && request.query.limit <= 20`,
      // on the reasoning that the app only ever queries one exact address.
      //
      // That reasoning was wrong, and it was my own. A rule cannot see WHICH
      // field a query filters on — only how many rows it asks for. Anyone
      // signed in could ask for twenty accounts ordered by any field, walk a
      // cursor through the collection, and leave with every name, address and
      // institution in the project. Twenty at a time is not a defence; it is
      // a page size.
      //
      // Finding a classmate now goes through /emailIndex, where the address is
      // the document name, so a lookup is a `get` of something you can already
      // spell rather than a query over everyone.
      allow list: if false;

      // The fields a profile has, and no others. Without this the length
      // limits below are decoration: a client could add a megabyte under a
      // name nobody checks, and every classmate who opens a group downloads it.
      function profileKeys() {
        return ['uid', 'name', 'email', 'role', 'institution', 'photo',
                'createdAt', 'updatedAt'];
      }

      // The profile photo is a small JPEG carried inside the document, because
      // there is no file storage. Optional, and capped: everybody in a class
      // downloads every member's profile, so this cap is the cost of a face.
      function photoFits() {
        return !('photo' in incoming()) || textWithin(incoming().photo, 40000);
      }

      allow create: if isSelf(userId)
        && incoming().keys().hasOnly(profileKeys())
        && incoming().uid == userId
        // The address is taken from the signed-in token, not from whatever the
        // client typed, so nobody can register themselves under someone
        // else's address and receive their shared notes.
        && incoming().email == request.auth.token.email.lower()
        && textWithin(incoming().name, 80)
        && textWithin(incoming().institution, 160)
        && incoming().role in ['student', 'teacher']
        && photoFits();

      allow update: if isSelf(userId)
        && incoming().keys().hasOnly(profileKeys())
        // Identity is fixed after creation. The name and the role can change;
        // who the document belongs to cannot.
        && incoming().uid == resource.data.uid
        && incoming().email == resource.data.email
        && textWithin(incoming().name, 80)
        && textWithin(incoming().institution, 160)
        && incoming().role in ['student', 'teacher']
        && photoFits();

      // Your own profile, and only your own.
      //
      // This used to be closed, with the reasoning that a deleted profile
      // leaves shared notes and group memberships pointing at nothing. That
      // reasoning loses to a rule outside this file: Google Play requires an
      // app that lets a person create an account to let them delete it from
      // inside the app. "Ask us by email" does not satisfy it, and neither
      // does the console.
      //
      // What dangles afterwards dangles honestly. A group keeps the uid in its
      // member list and the app shows it as a former member; a message keeps
      // the name it was sent under. Deleting those would mean editing other
      // people's conversations, which is worse than a gap.
      allow delete: if isSelf(userId);
    }

    // -------------------------------------------------------- emailIndex
    //
    // address → uid. The document NAME is the folded address, so looking a
    // classmate up is a `get` of a document you can name, and listing is shut.
    //
    // What this still allows, said plainly: somebody can test one address at a
    // time and learn whether it is registered. They get back a uid and no
    // name. That is a real cost and it is the one being paid on purpose —
    // the alternative, a queryable user table, hands over the whole directory.

    match /emailIndex/{address} {

      allow get: if signedIn();
      allow list: if false;

      // You may only ever claim your own address, because the document name
      // must equal the address on your own token. Nobody can point somebody
      // else's address at their uid and collect the notes meant for them.
      //
      // And the address must be verified. "On your own token" used to be the
      // whole check, but an email-and-password account can be created on any
      // address at all — Firebase does not ask whether you own it. Without
      // email_verified, somebody could register a classmate's university
      // address before the classmate did, claim this entry, and receive every
      // note and message sent to that address under a name of their choosing.
      // Google sign-ins are verified by Google, so they pass at once; a
      // password account passes once its confirmation link has been opened.
      allow create, update: if signedIn()
        && request.auth.token.email_verified == true
        && address == request.auth.token.email.lower()
        && incoming().keys().hasOnly(['uid', 'updatedAt'])
        && incoming().uid == request.auth.uid;

      // Removed when the account is deleted, by its owner, so the address can
      // be registered again by whoever actually holds it.
      allow delete: if signedIn()
        && address == request.auth.token.email.lower();
    }

    // ------------------------------------------------------------ groups
    //
    // A study group and a teacher's class are the same document with a
    // different `kind`, because a class is a study group where one member sets
    // the work. Membership is a list of uids on the group itself.

    match /groups/{groupId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }

      function isGroupOwner() {
        return signedIn() && request.auth.uid == resource.data.ownerUid;
      }

      // Members only, for both reading one group and listing your own.
      //
      // Firestore refuses a query it cannot prove stays inside this rule, so
      // the app's `array-contains` on memberUids is not merely how the right
      // rows are found — it is what makes the read legal at all. A query
      // without it fails rather than returning other people's groups.
      allow read: if isMember();

      allow create: if signedIn()
        && incoming().keys().hasOnly([
             'name', 'joinCode', 'ownerUid', 'ownerName', 'kind', 'subject',
             'memberUids', 'createdAt', 'updatedAt',
           ])
        && incoming().ownerUid == request.auth.uid
        // A group starts with exactly one member: the person making it. Nobody
        // gets to create a group with other people already in it.
        && incoming().memberUids == [request.auth.uid]
        && textWithin(incoming().name, 60)
        && textWithin(incoming().subject, 60)
        && textWithin(incoming().ownerName, 80)
        && incoming().kind in ['study', 'class']
        // Only a teacher account makes a class. A class is where work is set
        // and graded; a student who could make one could set work for their
        // classmates in the app's own teacher voice. The role is read from
        // the profile, which only its owner writes — so this is a statement
        // about the account, not a promise from the client.
        && (incoming().kind != 'class'
            || get(/databases/$(database)/documents/users/$(request.auth.uid))
                 .data.role == 'teacher')
        // Exactly six, and reserved in the same batch. The app always writes
        // the group and its code together; a group whose code was never
        // reserved could not be joined, and one with an empty code could
        // collide with every other one.
        && incoming().joinCode is string
        && incoming().joinCode.size() == 6
        && existsAfter(/databases/$(database)/documents/joinCodes/$(incoming().joinCode));

      // Joining with a code. The only change permitted to an outsider, and it
      // is pinned to the bone: the member list afterwards must equal the list
      // before plus this one uid. Not "contains" — equals. So a joiner cannot
      // add a friend, cannot drop anyone, and cannot touch the name.
      //
      // This comparison is why the app joins with arrayUnion and never reads
      // the group first: a person who is not yet a member is not allowed to
      // read it, so the before-and-after check has to happen here, on the
      // server, where both versions exist.
      allow update: if signedIn()
        && changedKeys().hasOnly(['memberUids', 'updatedAt'])
        && request.resource.data.memberUids
             == resource.data.memberUids.concat([request.auth.uid])
        // Already in? Then there is nothing to join. Without this a member
        // could send the same join over and over, appending their own uid each
        // time: the member list grows without limit, every other member
        // downloads it on every read, and at a megabyte the document stops
        // being writable at all. A member list is not a log.
        && !(request.auth.uid in resource.data.memberUids)
        // A ceiling on the same growth from the other direction. Sixty is far
        // above any real class and far below anything that hurts.
        && request.resource.data.memberUids.size() <= 60;

      // Leaving. The mirror image, and equally pinned.
      allow update: if isMember()
        && changedKeys().hasOnly(['memberUids', 'updatedAt'])
        && request.resource.data.memberUids
             == resource.data.memberUids.removeAll([request.auth.uid]);

      // The owner may rename the group and remove people from it. Not the
      // join code, not the kind, not who owns it: a group that can change its
      // own code would invalidate every copy of it already written down, and a
      // study group that can quietly become a class is a student who can
      // quietly start setting assignments.
      //
      // Remove — not add. The member list may only shrink here, and the owner
      // must still be on it. This used to accept any list at all, which let an
      // owner put any uid they had ever seen into a group without its owner's
      // say: the group then appeared in that person's list and its thread in
      // their chats. Joining is something a person does for themselves.
      allow update: if isGroupOwner()
        && changedKeys().hasOnly(['name', 'subject', 'memberUids', 'updatedAt'])
        && textWithin(incoming().name, 60)
        && textWithin(incoming().subject, 60)
        && (!changedKeys().hasAny(['memberUids'])
            || (resource.data.memberUids.hasAll(request.resource.data.memberUids)
                && request.auth.uid in request.resource.data.memberUids));

      allow delete: if isGroupOwner();

      // ------------------------------------------------------ classwork
      //
      // groups/{classId}/posts/{postId}                    teacher writes
      // groups/{classId}/posts/{postId}/submissions/{uid}  one per student
      //
      // Files are never in here — only Google Drive ids. The weight of a
      // class lives in its teacher's and students' own Drives.

      function classData() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }

      function inClass() {
        return signedIn() && request.auth.uid in classData().memberUids;
      }

      // The owner of a group whose kind is class. A study group's owner is
      // not a teacher and gets no classwork.
      function teachesClass() {
        return signedIn()
          && classData().ownerUid == request.auth.uid
          && classData().kind == 'class';
      }

      function filesFit(files) {
        return files is list && files.size() <= 10;
      }

      function maybeInt(value) {
        return value == null || value is int;
      }

      match /posts/{postId} {

        allow read: if inClass();

        allow create: if teachesClass()
          && incoming().keys().hasOnly([
               'kind', 'title', 'body', 'topic', 'dueAt', 'points', 'files',
               'authorUid', 'authorName', 'createdAt', 'updatedAt',
             ])
          && incoming().authorUid == request.auth.uid
          && incoming().kind in ['announcement', 'material', 'assignment']
          && textWithin(incoming().title, 200)
          && textWithin(incoming().body, 5000)
          && textWithin(incoming().topic, 60)
          && textWithin(incoming().authorName, 80)
          && maybeInt(incoming().dueAt)
          && (incoming().points == null
              || (incoming().points is int
                  && incoming().points >= 1 && incoming().points <= 1000))
          && filesFit(incoming().files);

        // The words and the deadline may change; the kind, the files and who
        // posted it may not.
        allow update: if teachesClass()
          && changedKeys().hasOnly(
               ['title', 'body', 'topic', 'dueAt', 'points', 'updatedAt'])
          && textWithin(incoming().title, 200)
          && textWithin(incoming().body, 5000)
          && textWithin(incoming().topic, 60)
          && maybeInt(incoming().dueAt)
          && (incoming().points == null
              || (incoming().points is int
                  && incoming().points >= 1 && incoming().points <= 1000));

        allow delete: if teachesClass();

        // ------------------------------------------------ submissions
        //
        // The document id is the student's uid, so "your own" needs no read,
        // and a second submission from the same student cannot exist.

        match /submissions/{studentUid} {

          function postData() {
            return get(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId)).data;
          }

          function studentKeys() {
            return ['uid', 'name', 'text', 'files', 'state', 'submittedAt',
                    'updatedAt'];
          }

          // What a student writes, checked the same way on create and update.
          // A handed-in time must be now, give or take a few minutes of clock
          // drift — otherwise "late" would be whatever the student typed.
          function studentWorkFits() {
            return incoming().uid == studentUid
              && textWithin(incoming().name, 80)
              && textWithin(incoming().text, 5000)
              && filesFit(incoming().files)
              && incoming().state in ['draft', 'turnedIn']
              && (incoming().state == 'draft'
                  || (incoming().submittedAt is int
                      && incoming().submittedAt > request.time.toMillis() - 300000
                      && incoming().submittedAt < request.time.toMillis() + 300000))
              && maybeInt(incoming().submittedAt);
          }

          // Your own work, and the teacher's view of everyone's. Classmates
          // cannot read each other's answers.
          allow read: if (isSelf(studentUid) && inClass()) || teachesClass();

          allow create: if isSelf(studentUid)
            && inClass()
            && postData().kind == 'assignment'
            && incoming().keys().hasOnly(studentKeys())
            && studentWorkFits();

          // A student edits, hands in or takes back their own work. Never the
          // grade or the feedback — those keys are simply not theirs to change.
          allow update: if isSelf(studentUid)
            && inClass()
            && changedKeys().hasOnly(studentKeys())
            && studentWorkFits();

          // The teacher grades and returns. Only those four fields.
          allow update: if teachesClass()
            && changedKeys().hasOnly(['grade', 'feedback', 'state', 'returnedAt'])
            && incoming().state == 'returned'
            && (incoming().grade == null
                || (incoming().grade is int
                    && incoming().grade >= 0 && incoming().grade <= 1000))
            && textWithin(incoming().feedback, 2000)
            && incoming().returnedAt is int;

          // Only as part of deleting the assignment.
          allow delete: if teachesClass();
        }
      }
    }

    // --------------------------------------------------------- joinCodes
    //
    // code → group. A tiny lookup that exists for one reason: somebody holding
    // a code is, by definition, not yet a member, so they cannot read the
    // group. This holds only a name and an id — never the member list.

    match /joinCodes/{code} {

      // Looking up a code you have been given. `get` only: `list` would turn
      // this into a catalogue of every group in the project, which is exactly
      // what a join code is supposed to prevent.
      allow get: if signedIn();
      allow list: if false;

      // Only for a group you own, carrying this very code. Checked against the
      // group as it will be once the batch lands — getAfter, not get — because
      // the app creates the two together and the group does not exist yet
      // beforehand. Without this anyone could mint codes pointing at any group
      // id they had come across.
      allow create: if signedIn()
        && incoming().keys().hasOnly(['groupId', 'name', 'ownerUid', 'createdAt'])
        && incoming().ownerUid == request.auth.uid
        && incoming().groupId is string
        && textWithin(incoming().name, 60)
        && getAfter(/databases/$(database)/documents/groups/$(incoming().groupId))
             .data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(incoming().groupId))
             .data.joinCode == code;

      // This single line is what makes a code unique.
      //
      // Firestore applies `create` only when the document does not exist, so
      // two people racing for the same code do not both succeed: the first
      // creates it, the second is refused and the app tries another code. No
      // read-then-write, no window between checking and taking — the race is
      // settled on the server, which is the only place it can be.
      allow update: if false;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ------------------------------------------------------------ shares
    //
    // One note sent to one person, waiting to be accepted. A note sent to a
    // group of eight is eight documents, written in one batch — because
    // accepting is a personal decision, and a shared document that everyone
    // must write their answer into is far harder to make safe than one with a
    // single owner.

    match /shares/{shareId} {

      // Both ends can see it: the recipient to answer, the sender to know it
      // was received. Nobody else, including other members of the group it
      // was sent through.
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid
            || resource.data.fromUid == request.auth.uid);

      allow create: if signedIn()
        // What a share carries, and nothing else — otherwise the 700 KB limit
        // on the payload below is a limit on one field of a document that can
        // still be filled to a megabyte through any other.
        && incoming().keys().hasOnly([
             'fromUid', 'fromName', 'toUid', 'title', 'payload', 'groupId',
             'groupName', 'message', 'subjectCode', 'fileCount', 'state',
             'createdAt',
           ])
        // You can only send as yourself. Without this, a note could arrive
        // wearing a classmate's name — and the receiving student has no way to
        // tell, because the name is all the inbox has.
        && incoming().fromUid == request.auth.uid
        && textWithin(incoming().fromName, 80)
        && incoming().toUid is string
        && incoming().toUid != request.auth.uid
        // It starts waiting. A share cannot be created already accepted.
        && incoming().state == 'pending'
        && textWithin(incoming().title, 200)
        && textWithin(incoming().message, 500)
        && textWithin(incoming().groupName, 60)
        // The same budget the app enforces before sending, enforced again
        // where it cannot be edited out. 700 KB.
        && textWithin(incoming().payload, 716800);

      // Only the recipient answers, and answering is the only thing an update
      // may do. The note itself is fixed once sent: a sender who could edit the
      // payload afterwards could swap the note for something else after it had
      // already been accepted.
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && changedKeys().hasOnly(['state', 'respondedAt'])
        && incoming().state in ['accepted', 'declined'];

      // Either end may remove a share, answered or not.
      //
      // It used to be `false`, which meant every note anyone ever sent stayed
      // in the project for good, at up to 700 KB each. On the free plan the
      // whole project has one gigabyte: fifteen hundred shares fill it, and
      // when it is full nobody can send anything. Letting the two people who
      // can already read a share delete it is what keeps ordinary use from
      // accumulating. A deliberate flood is still possible and is not solved
      // here — see SECURITY_REVIEW.md.
      //
      // It was later limited to answered shares. That left a sender unable to
      // withdraw a note sent to the wrong person, and an account being deleted
      // unable to take its unanswered shares with it — so they would wait in
      // somebody's inbox, from an account that no longer exists, for ever.
      allow delete: if signedIn()
        && (resource.data.toUid == request.auth.uid
            || resource.data.fromUid == request.auth.uid);
    }

    // ------------------------------------------------------------- chats
    //
    // One collection for both kinds of conversation, and the kind is readable
    // from the address itself:
    //
    //   grp_<groupId>   a group's thread — the GROUP decides who is in it
    //   dm_<a>_<b>      two people, uids sorted
    //
    // Deriving it from the id rather than from a field inside the document is
    // not a trick for its own sake. A batched write is checked against the
    // state *before* the batch, so a rule that had to read the conversation
    // document would refuse the very first message in a new group thread —
    // the message and the document it depends on arrive together. Reading the
    // address needs nothing that is not already in the request.

    function isGroupThread(chatId) {
      return chatId[0:4] == 'grp_';
    }

    function groupOf(chatId) {
      return chatId[4:chatId.size()];
    }

    function isDirectThread(chatId) {
      return chatId[0:3] == 'dm_';
    }

    function inGroup(groupId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    function threadData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    // True when [owner] has blocked the caller. `exists` first, because a
    // `get` of a missing document is an error, and an error denies — which
    // would refuse every message to anybody who has never blocked anyone.
    function blockedBy(owner) {
      return exists(/databases/$(database)/documents/blocks/$(owner))
        && request.auth.uid in
             get(/databases/$(database)/documents/blocks/$(owner)).data.uids;
    }

    // The member of a direct thread who is not the caller.
    function otherInThread(chatId) {
      let members = threadData(chatId).memberUids;
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    // A direct thread whose other member has blocked the caller. Group
    // threads are not covered: a group is shared space, and blocking there
    // hides the person on the blocker's own screen instead.
    function blockedInThread(chatId) {
      return isDirectThread(chatId) && blockedBy(otherInThread(chatId));
    }

    // May this account read and write in this conversation at all.
    function canUseThread(chatId) {
      return signedIn() && (
        (isGroupThread(chatId) && inGroup(groupOf(chatId)))
        || (isDirectThread(chatId)
            && request.auth.uid in threadData(chatId).memberUids)
      );
    }

    // ---------------------------------------------------------- dmQuota
    //
    // How many message requests this account has sent today. A request can
    // only be created in the same batch as a bump of this counter (see the
    // dmRequests create rule), and the counter can only go up by one a time,
    // so the daily limit is enforced here and not just in the app. There is
    // no server to count for us; this is the free way to do it.

    function today() {
      return math.floor(request.time.toMillis() / 86400000);
    }

    match /dmQuota/{userId} {
      allow get: if isSelf(userId);
      allow list: if false;

      allow create, update: if isSelf(userId)
        && incoming().keys().hasOnly(['day', 'count'])
        && incoming().day == today()
        && incoming().count is int
        && incoming().count >= 1
        && incoming().count <= 20
        // A new day starts again at one; the same day counts up by one.
        && (resource == null || resource.data.day != today()
              ? incoming().count == 1
              : incoming().count == resource.data.count + 1);

      allow delete: if false;
    }

    // ------------------------------------------------------- dmRequests
    //
    // A message request. The document NAME is the direct-chat address of the
    // two people, so there is exactly one request per pair: two people asking
    // each other at the same moment cannot create two, and a declined request
    // cannot be replaced with a fresh one.
    //
    // A new direct conversation can only be created once this says 'accepted'
    // (see the chats rule). Conversations that already existed are untouched.

    function requestId(a, b) {
      return a < b ? 'dm_' + a + '_' + b : 'dm_' + b + '_' + a;
    }

    match /dmRequests/{reqId} {

      // `resource == null` lets the app ask "is there a request for this pair?"
      // and be told no. Without it a get of a missing document is an error,
      // and an error denies.
      allow get: if signedIn()
        && (resource == null
            || resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow list: if signedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && incoming().keys().hasOnly(
             ['fromUid', 'toUid', 'text', 'state', 'createdAt'])
        && incoming().fromUid == request.auth.uid
        && incoming().toUid is string
        && incoming().toUid != request.auth.uid
        && reqId == requestId(incoming().fromUid, incoming().toUid)
        && incoming().state == 'pending'
        && incoming().text is string
        && incoming().text.size() > 0
        && incoming().text.size() <= 500
        && incoming().createdAt is int
        // At most 20 a day: the counter is bumped in the same batch.
        && existsAfter(/databases/$(database)/documents/dmQuota/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/dmQuota/$(request.auth.uid))
             .data.day == today()
        && getAfter(/databases/$(database)/documents/dmQuota/$(request.auth.uid))
             .data.count <= 20
        // Somebody who has blocked you cannot be asked.
        && !blockedBy(incoming().toUid);

      // Only the person asked answers, and answering is all an update may do.
      // The sender cannot touch a request once sent: not to accept it for the
      // recipient, not to reset a declined one to pending. A decline can be
      // changed to accept later by the recipient, never by the sender.
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.state in ['pending', 'declined']
        && changedKeys().hasOnly(['state', 'respondedAt'])
        && incoming().state in ['accepted', 'declined'];

      // The recipient may clear any request. The sender may withdraw one that
      // has not been declined — a declined request must stay, or deleting and
      // re-sending would make a decline meaningless.
      allow delete: if signedIn()
        && (resource.data.toUid == request.auth.uid
            || (resource.data.fromUid == request.auth.uid
                && resource.data.state != 'declined'));
    }

    match /chats/{chatId} {

      allow get: if canUseThread(chatId);

      // Listing is only ever "my direct conversations", and the app's
      // array-contains on memberUids is what keeps that inside this rule.
      // Group threads carry no member list, so they can never come back from
      // this query — they are found through the groups instead.
      allow list: if signedIn()
        && request.auth.uid in resource.data.memberUids;

      // A group thread. Nothing about who is in it is stored here, so there is
      // nothing here to get out of step with the group.
      //
      // Held to the fields the app writes, and to the creator's own receipt,
      // typing flag and name — the same limits an update has below, which a
      // first write would otherwise slip past simply by being first.
      allow create: if isGroupThread(chatId) && inGroup(groupOf(chatId))
        && incoming().keys().hasOnly([
             'kind', 'groupId', 'title',
             'lastText', 'lastFromUid', 'lastFromName', 'lastAt',
             'readAt', 'typingAt',
           ])
        && (!('kind' in incoming()) || incoming().kind == 'group')
        && (!('groupId' in incoming())
            || incoming().groupId == groupOf(chatId))
        && (!('lastFromUid' in incoming())
            || incoming().lastFromUid == request.auth.uid)
        && (!('readAt' in incoming())
            || incoming().readAt.keys().hasOnly([request.auth.uid]))
        && (!('typingAt' in incoming())
            || incoming().typingAt.keys().hasOnly([request.auth.uid]));

      // A direct thread, and the address must be the one these two people
      // would compute. Checked rather than trusted: without this, a thread
      // could be created at an address that has nothing to do with its
      // members, and the people who would later compute the real address
      // would find an empty conversation.
      allow create: if signedIn()
        && isDirectThread(chatId)
        && incoming().keys().hasOnly(['kind', 'memberUids'])
        && incoming().kind == 'direct'
        && incoming().memberUids.size() == 2
        // Nobody can open a conversation with someone who has blocked them.
        && !blockedBy(incoming().memberUids[0] == request.auth.uid
                        ? incoming().memberUids[1]
                        : incoming().memberUids[0])
        && request.auth.uid in incoming().memberUids
        && incoming().memberUids[0] < incoming().memberUids[1]
        && chatId == 'dm_' + incoming().memberUids[0]
                   + '_' + incoming().memberUids[1]
        // A new conversation needs an accepted message request first. Chats
        // that already exist are updated, not created, so they keep working.
        && exists(/databases/$(database)/documents/dmRequests/$(chatId))
        && get(/databases/$(database)/documents/dmRequests/$(chatId))
             .data.state == 'accepted';

      // Sending a message updates what the list shows; opening the thread
      // writes a read receipt; typing writes a flag. All three land here, and
      // each is held to its own fields.
      allow update: if canUseThread(chatId)
        // `kind` and `groupId` are deliberately absent: a write that leaves
        // them as they are does not appear in changedKeys at all, so the app's
        // merge still works, while a write that CHANGES them is refused. They
        // say which group a thread belongs to, and a thread that can be
        // re-pointed at another group is a thread whose history moves house.
        && changedKeys().hasOnly([
             'title', 'memberUids',
             'lastText', 'lastFromUid', 'lastFromName', 'lastAt',
             'readAt', 'typingAt',
           ])
        // You may only ever stamp your own receipt, and only your own typing
        // flag. Otherwise one member could mark a conversation read for
        // everybody, or leave somebody else showing as typing for good.
        && (!changedKeys().hasAny(['readAt'])
            || request.resource.data.readAt
                 .diff(resource.data.get('readAt', {}))
                 .affectedKeys().hasOnly([request.auth.uid]))
        && (!changedKeys().hasAny(['typingAt'])
            || request.resource.data.typingAt
                 .diff(resource.data.get('typingAt', {}))
                 .affectedKeys().hasOnly([request.auth.uid]))
        // The member list of a direct thread is fixed once set. A thread that
        // could gain a third person would make its own address a lie.
        && (!changedKeys().hasAny(['memberUids'])
            || request.resource.data.memberUids == resource.data.memberUids)
        // The list's "last message from" is whoever is writing it. Otherwise
        // one member could make the preview say another had just spoken.
        && (!changedKeys().hasAny(['lastFromUid'])
            || request.resource.data.lastFromUid == request.auth.uid);

      // A conversation is not deleted. Removing it would take everyone else's
      // copy with it, and leaving a group is the way out of a group thread.
      allow delete: if false;

      // ------------------------------------------------------- messages

      match /messages/{messageId} {

        allow read: if canUseThread(chatId);

        allow create: if canUseThread(chatId)
          && !blockedInThread(chatId)
          && incoming().keys().hasOnly([
               'fromUid', 'fromName', 'kind', 'text', 'title', 'subjectCode',
               'fileCount', 'blobId', 'thumb', 'durationMs', 'createdAt',
             ])
          // You can only speak as yourself. The name beside a message is all
          // the reader has.
          && incoming().fromUid == request.auth.uid
          && textWithin(incoming().fromName, 80)
          && textWithin(incoming().text, 2000)
          && textWithin(incoming().title, 200)
          && textWithin(incoming().subjectCode, 40)
          // No 'system'. The app never sends one, and a member who could would
          // be able to post "X removed you from the group" in the app's own
          // voice. If the app ever needs notices, they need their own rule.
          && incoming().kind in ['text', 'note', 'image', 'voice']
          // Small enough to scroll past. The weight of a posted note lives in
          // `blobs`, fetched only by whoever asks for it.
          && textWithin(incoming().thumb, 40000);

        // A message is said, not edited. Allowing an update would let the
        // words above somebody's reply change after they replied to them.
        allow update, delete: if false;
      }

      // ---------------------------------------------------------- blobs
      //
      // The heavy part of a message — a posted note's payload — kept out of
      // the message so that scrolling a term's conversation does not download
      // every note anybody ever posted.

      match /blobs/{blobId} {

        allow read: if canUseThread(chatId);

        allow create: if canUseThread(chatId)
          && !blockedInThread(chatId)
          && incoming().keys().hasOnly(['payload', 'fromUid', 'createdAt'])
          && incoming().fromUid == request.auth.uid
          // The same 700 KB the app enforces, enforced again where it cannot
          // be edited out — and, with hasOnly above, the only place the
          // weight can go.
          && textWithin(incoming().payload, 716800);

        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------ blocks
    //
    // One document per account: the uids it has blocked. Private — only its
    // owner can read it, so nobody can find out who has blocked them. The
    // rules above read it with get(), which is not limited by this.

    match /blocks/{userId} {
      allow read: if isSelf(userId);

      allow create, update: if isSelf(userId)
        && incoming().keys().hasOnly(['uids', 'updatedAt'])
        && incoming().uids is list
        && incoming().uids.size() <= 500;

      allow delete: if isSelf(userId);
    }

    // ----------------------------------------------------------- reports
    //
    // Write-only. A report is for the project owner, who reads them in the
    // Firebase console; nobody can read one from the app — not the reporter,
    // and certainly not the person reported. The reported text is copied in,
    // because messages cannot be deleted and the report has to say what was
    // reported even if the conversation is later out of reach.

    match /reports/{reportId} {
      allow create: if signedIn()
        && incoming().keys().hasOnly([
             'reporterUid', 'targetUid', 'reason', 'details', 'chatId',
             'messageId', 'shareId', 'messageText', 'createdAt',
           ])
        && incoming().reporterUid == request.auth.uid
        && incoming().targetUid is string
        && incoming().targetUid.size() > 0
        && incoming().targetUid != request.auth.uid
        && incoming().reason in ['harassment', 'inappropriate', 'spam', 'other']
        && textWithin(incoming().details, 500)
        && textWithin(incoming().chatId, 200)
        && textWithin(incoming().messageId, 200)
        && textWithin(incoming().shareId, 200)
        && textWithin(incoming().messageText, 2000)
        && incoming().createdAt is int;

      allow read, update, delete: if false;
    }

    // --------------------------------------------------------- everything else
    //
    // Shut. A collection nobody has thought about should not be writable just
    // because nobody has thought about it.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
